# Session Dock settings. install.sh copies this file to .env (if it doesn't exist).
# After editing .env, apply it with:  ./install.sh   (or: systemctl --user restart session-dock)

# Where the app listens. Keep 127.0.0.1 and put a private HTTPS proxy in front
# (see README: "Use it from your phone"). Never expose it to the open internet.
SD_PORT=50760
SD_HOST=127.0.0.1

# Folder browsing is limited to SD_ROOT (default: your home folder).
#SD_ROOT=/home/you
# The folder the app opens at (default: SD_ROOT).
#SD_START_DIR=/home/you/projects

# Terminal program for new windows. Default: your desktop's own terminal, else
# the first one installed of: xfce4-terminal, gnome-terminal, konsole,
# mate-terminal, kitty, alacritty, wezterm, foot, xterm.
#SD_TERMINAL=xfce4-terminal

# Claude Code command (default: ~/.local/bin/claude, else the first "claude" on PATH).
#SD_CLAUDE_BIN=/home/you/.local/bin/claude
# Set this only if you use CLAUDE_CONFIG_DIR for Claude Code itself.
#CLAUDE_CONFIG_DIR=/home/you/.claude

# Where the PIN hash and window state are kept (default: ./data).
#SD_DATA_DIR=/home/you/.local/state/session-dock

# Your desktop isn't detected? Add its session process name (see `ps -u $USER`).
#SD_DESKTOP_PROCESS=my-session
